# Copy to .dev.vars for `wrangler dev`. Do NOT commit .dev.vars.

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-
HERMES_GATEWAY_TOKEN=

# --- Slack (Socket Mode — no public URL needed) ---
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-                  # connections:write scope
SLACK_ALLOWED_USERS=                   # comma-separated Slack member IDs (U01ABC2DEF3)

# --- Optional: hibernation ---
# 'never' (default) keeps the container warm. Set a duration to scale to zero.
# SANDBOX_SLEEP_AFTER=10m
