# Personal config — copy to `.env` (gitignored), fill in, then `npm run deploy`.
# Applied via `wrangler deploy --var KEY:VALUE` by scripts/deploy.sh.
# These are NOT secrets — Slack member/channel IDs are visible to anyone in
# the workspace — but they identify you, so they shouldn't be committed.

# This agent's identity — the ONE knob to change when cloning the repo to
# stand up a new agent. It names the deployed Worker and namespaces this
# agent's snapshots in the shared R2 bucket. Lowercase, hyphen-friendly.
# Leave unset to deploy the default "hermes-flare" agent.
AGENT_NAME=hermes-flare

# Comma-separated Slack member IDs (U01ABC2DEF3) allowed to talk to the bot.
SLACK_ALLOWED_USERS=

# Optional Slack channel ID where Hermes posts scheduled/cron output.
# Leave empty to disable.
SLACK_HOME_CHANNEL=

# Public URL of this Worker — used inside the Hermes container by the
# cloudflare_sandbox terminal backend. Typically:
#   https://hermes-flare.<your-subdomain>.workers.dev
WORKER_PUBLIC_URL=

# Optional overrides (defaults live in wrangler.jsonc):
# SLACK_REPLY_IN_THREAD=true
# SANDBOX_SLEEP_AFTER=never
# SNAPSHOT_INTERVAL_MINUTES=60
# BACKUP_RETENTION_DAYS=3
