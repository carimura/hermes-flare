# All non-secret config for this agent. Copy to `.env` (gitignored), fill in,
# then `npm run deploy` (scripts/deploy.sh applies each as `wrangler --var`).
# Secrets do NOT go here — push them with `wrangler secret put` (see README).
#
# Only AGENT_NAME and WORKERS_SUBDOMAIN are needed to start; the rest are
# optional and fall back to the code defaults shown.

# This agent's identity — the ONE knob to change when cloning. Names the
# deployed Worker and namespaces this agent's snapshots in the shared R2
# bucket. Lowercase, hyphen-friendly. (default: hermes-flare)
AGENT_NAME=hermes-flare

# Your account's workers.dev subdomain — the <sub> in
# https://<AGENT_NAME>.<sub>.workers.dev. The Worker composes its own public
# URL from this for the container's terminal backend.
WORKERS_SUBDOMAIN=

# Comma-separated Slack member IDs (U01ABC2DEF3) allowed to talk to the bot.
SLACK_ALLOWED_USERS=

# Optional Slack channel ID where Hermes posts scheduled/cron output.
SLACK_HOME_CHANNEL=

# Optional overrides (defaults shown):
# SLACK_REPLY_IN_THREAD=true     # false → post at channel top level, not threaded
# SANDBOX_SLEEP_AFTER=never      # "10m" / "1h" to hibernate when idle
# SNAPSHOT_INTERVAL_MINUTES=240  # max age (min) of latest backup before re-snapshot
# BACKUP_RETENTION_DAYS=3        # days of backups to retain
# WORKER_PUBLIC_URL=             # override the derived URL (e.g. custom domain)
