{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermes-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Two container classes:
  //   HermesSandbox — long-lived, runs the Hermes agent itself
  //   ExecSandbox   — isolated sandbox where Hermes-issued shell commands run
  "containers": [
    {
      "class_name": "HermesSandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1,
      // `wrangler containers ssh <container-id>` for direct shell access.
      "ssh": { "enabled": true }
    },
    {
      "class_name": "ExecSandbox",
      "image": "./Dockerfile.exec",
      "instance_type": "lite",
      "max_instances": 1,
      "ssh": { "enabled": true }
    }
  ],

  // Durable Object bindings (provided by @cloudflare/sandbox).
  "durable_objects": {
    "bindings": [
      { "class_name": "HermesSandbox", "name": "HermesSandbox" },
      { "class_name": "ExecSandbox", "name": "ExecSandbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HermesSandbox"] },
    { "tag": "v2", "new_sqlite_classes": ["ExecSandbox"] }
  ],

  // R2 bucket for squashfs snapshots. The binding name BACKUP_BUCKET is the
  // convention @cloudflare/sandbox expects.
  "r2_buckets": [
    { "binding": "BACKUP_BUCKET", "bucket_name": "hermes-cloudflare-data" }
  ],

  // Wake the container periodically to give cron-scheduled tasks inside
  // Hermes a chance to fire. Every minute is overkill for now; tune later.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Universal non-secret defaults. Personal config (Slack member IDs,
  // home channel) lives in `.env` (gitignored) and is applied via
  // `wrangler deploy --var` by scripts/deploy.sh. Use `npm run deploy`.
  // Secrets and personal vars are documented in README.md. Set secrets via
  // `wrangler secret put`; set personal vars in `.env` (see .env.example).
  "vars": {
    // "true" → Hermes replies in a thread (Slack default).
    // "false" → Hermes posts at the channel top level.
    "SLACK_REPLY_IN_THREAD": "true",

    // Container hibernation. "never" keeps it warm (faster, more expensive).
    // Set "10m" / "1h" / "30s" to scale to zero when idle.
    "SANDBOX_SLEEP_AFTER": "never"
  }
}
