{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermes-flare",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Two container classes:
  //   Agent — long-lived, runs the Hermes agent itself
  //   Exec  — isolated sandbox where Hermes-issued shell commands run
  "containers": [
    {
      "class_name": "Agent",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1,
      "ssh": { "enabled": true },
      "authorized_keys": [
      { "name": "chad", "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICUclJrxuOG4koiq8iow7ByY/5TO6MgVrDEWEX+vOJcY hermes-cf" }
      ]
    },
    {
      "class_name": "Exec",
      "image": "./Dockerfile.exec",
      "instance_type": "lite",
      "max_instances": 1,
      "ssh": { "enabled": true },
      "authorized_keys": [
      { "name": "chad", "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICUclJrxuOG4koiq8iow7ByY/5TO6MgVrDEWEX+vOJcY hermes-cf" }
      ]
    }
  ],

  // Durable Object bindings (provided by @cloudflare/sandbox).
  "durable_objects": {
    "bindings": [
      { "class_name": "Agent", "name": "Agent" },
      { "class_name": "Exec", "name": "Exec" }
    ]
  },
  // Fresh migration: this Worker (`hermes-flare`) is new; nothing to migrate
  // from. The old Worker (`hermes-cloudflare`) keeps its own state until
  // manually deleted via `wrangler delete`.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Agent", "Exec"] }
  ],

  // R2 bucket for squashfs snapshots. Shared across all agents — each agent's
  // metadata keys are namespaced under `<AGENT_NAME>/` (see persistence.ts),
  // so a new agent needs no new bucket, just a distinct AGENT_NAME. The
  // binding name BACKUP_BUCKET is the convention @cloudflare/sandbox expects.
  "r2_buckets": [
    { "binding": "BACKUP_BUCKET", "bucket_name": "hermes-flare-data" }
  ],

  // Wake the container every 5 min: restore-if-needed, keep the gateway alive,
  // and snapshot /home/hermes to R2 once the last backup is older than
  // SNAPSHOT_INTERVAL_MINUTES (see scheduled() in src/index.ts) so a fresh
  // backup always exists before its TTL expires.
  "triggers": {
    "crons": ["*/5 * * * *"]
  }

  // No `vars` block on purpose: ALL non-secret config (AGENT_NAME,
  // WORKERS_SUBDOMAIN, Slack IDs, snapshot cadence, ...) lives in `.env`
  // (gitignored) and is applied via `wrangler deploy --var` by
  // scripts/deploy.sh — see .env.example. Optional vars fall back to code
  // defaults in src/index.ts when unset. This file stays infrastructure-only;
  // secrets go via `wrangler secret put`.
}
