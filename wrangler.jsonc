{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermes-flare",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Two container classes:
  //   Agent — long-lived, runs the Hermes agent itself
  //   Exec  — isolated sandbox where Hermes-issued shell commands run
  "containers": [
    {
      "class_name": "Agent",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1,
      "ssh": { "enabled": true },
      "authorized_keys": [
      { "name": "chad", "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICUclJrxuOG4koiq8iow7ByY/5TO6MgVrDEWEX+vOJcY hermes-cf" }
      ]
    },
    {
      "class_name": "Exec",
      "image": "./Dockerfile.exec",
      "instance_type": "lite",
      "max_instances": 1,
      "ssh": { "enabled": true },
      "authorized_keys": [
      { "name": "chad", "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICUclJrxuOG4koiq8iow7ByY/5TO6MgVrDEWEX+vOJcY hermes-cf" }
      ]
    }
  ],

  // Durable Object bindings (provided by @cloudflare/sandbox).
  "durable_objects": {
    "bindings": [
      { "class_name": "Agent", "name": "Agent" },
      { "class_name": "Exec", "name": "Exec" }
    ]
  },
  // Fresh migration: this Worker (`hermes-flare`) is new; nothing to migrate
  // from. The old Worker (`hermes-cloudflare`) keeps its own state until
  // manually deleted via `wrangler delete`.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Agent", "Exec"] }
  ],

  // R2 bucket for squashfs snapshots. The binding name BACKUP_BUCKET is the
  // convention @cloudflare/sandbox expects.
  "r2_buckets": [
    { "binding": "BACKUP_BUCKET", "bucket_name": "hermes-flare-data" }
  ],

  // Wake the container every 5 min: restore-if-needed, keep the gateway alive,
  // and snapshot /home/hermes to R2 once the last backup is older than
  // SNAPSHOT_INTERVAL_MINUTES (see scheduled() in src/index.ts) so a fresh
  // backup always exists before the previous one's 72h TTL expires.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Universal non-secret defaults. Personal config (Slack member IDs,
  // home channel) lives in `.env` (gitignored) and is applied via
  // `wrangler deploy --var` by scripts/deploy.sh. Use `npm run deploy`.
  // Secrets and personal vars are documented in README.md. Set secrets via
  // `wrangler secret put`; set personal vars in `.env` (see .env.example).
  "vars": {
    // "true" → Hermes replies in a thread (Slack default).
    // "false" → Hermes posts at the channel top level.
    "SLACK_REPLY_IN_THREAD": "true",

    // Container hibernation. "never" keeps it warm (faster, more expensive).
    // Set "10m" / "1h" / "30s" to scale to zero when idle.
    "SANDBOX_SLEEP_AFTER": "never",

    // How stale the latest R2 backup may get (minutes) before the 5-min cron
    // takes a fresh snapshot. Values below 5 effectively mean "every tick".
    "SNAPSHOT_INTERVAL_MINUTES": "60",

    // Days of backups to retain. Each snapshot prunes backups older than this
    // from R2; each backup's ttl is set a day beyond it so retained backups
    // stay restorable. Raise SNAPSHOT_INTERVAL_MINUTES to keep fewer.
    "BACKUP_RETENTION_DAYS": "3"
  }
}
